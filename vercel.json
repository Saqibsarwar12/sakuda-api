{
  "name": "sakuda-api",
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/admin",
      "dest": "/api/index.js"
    }
  ],
  "env": {
    "JWT_SECRET": "sakuda-secret-key-change-in-production"
  }
}